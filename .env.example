APP_NAME=English Learning API
APP_ENV=development
BACKEND_CORS_ORIGINS=*
JWT_SECRET_KEY=change-me-in-production-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_BASE_URL=https://api.openai.com/v1
STT_PROVIDER=openai
STT_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
STT_FALLBACK_MODEL=whisper-1
STT_LANGUAGE_HINT=en
STT_TIMEOUT_SECONDS=30
STT_BASE_URL=https://api.openai.com/v1
VOICE_MAX_UPLOAD_BYTES=10485760
POSTGRES_DB=english_learning
POSTGRES_USER=english_user
POSTGRES_PASSWORD=english_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://english_user:english_password@127.0.0.1:5432/english_learning
REDIS_URL=redis://127.0.0.1:6379/0
API_HOST=127.0.0.1
API_PORT=8000
